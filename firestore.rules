rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmailId(email) {
      return email is string
        && email.size() >= 5
        && email.size() <= 128
        && email == email.lower()
        && email.matches('^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    function userEmail() {
      return request.auth.token.email.lower();
    }

    function isAdmin() {
      return isVerifiedUser() && (
        userEmail() == 'abelminaya0@gmail.com'
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isNotSuspendedVerifiedUser() {
      return isAdmin() || (
        isVerifiedUser()
        && (
          !exists(/databases/$(database)/documents/clients/$(userEmail()))
          || get(/databases/$(database)/documents/clients/$(userEmail())).data.active == true
        )
      );
    }

    // --- Validation Blueprints (Create + Update) ---
    function isValidAdmin(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && isValidId(data.uid)
        && isValidEmailId(data.email)
        && data.createdAt is timestamp;
    }

    function isValidClient(data) {
      return data.keys().hasAll([
          'email', 'clientName', 'active', 'planName', 'amountPaid',
          'currency', 'notes', 'uid', 'displayName', 'photoURL',
          'loginCount', 'createdAt', 'updatedAt', 'createdBy'
        ])
        && data.keys().hasOnly([
          'email', 'clientName', 'active', 'planName', 'amountPaid',
          'currency', 'notes', 'uid', 'displayName', 'photoURL',
          'loginCount', 'lastLoginAt', 'createdAt', 'updatedAt', 'createdBy'
        ])
        && isValidEmailId(data.email)
        && data.clientName is string && data.clientName.size() <= 80
        && data.active is bool
        && data.planName is string && data.planName.size() > 0 && data.planName.size() <= 50
        && (data.amountPaid is int || data.amountPaid is float)
        && data.amountPaid >= 0 && data.amountPaid <= 1000000
        && data.currency in ['PEN', 'USD']
        && data.notes is string && data.notes.size() <= 300
        && data.uid is string && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() <= 100
        && data.photoURL is string && data.photoURL.size() <= 400
        && data.loginCount is int && data.loginCount >= 0 && data.loginCount <= 10000000
        && (!('lastLoginAt' in data) || data.lastLoginAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && isValidId(data.createdBy);
    }

    function isValidAccessRequest(data) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'photoURL', 'status', 'requestedAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'status', 'requestedAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && isValidEmailId(data.email)
        && data.displayName is string && data.displayName.size() <= 100
        && data.photoURL is string && data.photoURL.size() <= 400
        && data.status in ['pending', 'approved', 'rejected']
        && data.requestedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAccessLog(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'enteredAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'enteredAt'])
        && isValidId(data.uid)
        && isValidEmailId(data.email)
        && data.displayName is string && data.displayName.size() <= 100
        && data.enteredAt is timestamp;
    }

    function isValidUserWorkspace(data) {
      return data.keys().hasAll([
          'uid', 'email', 'playlists', 'tracksMeta', 'samplerBanks', 'activeBankId', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'playlists', 'tracksMeta', 'samplerBanks', 'activeBankId', 'updatedAt'
        ])
        && isValidId(data.uid)
        && isValidEmailId(data.email)
        && data.playlists is list && data.playlists.size() <= 100
        && (data.playlists.size() == 0 || data.playlists[0] is map)
        && data.tracksMeta is list && data.tracksMeta.size() <= 500
        && (data.tracksMeta.size() == 0 || data.tracksMeta[0] is map)
        && data.samplerBanks is list && data.samplerBanks.size() <= 20
        && (data.samplerBanks.size() == 0 || data.samplerBanks[0] is map)
        && data.activeBankId is string && data.activeBankId.size() <= 64
        && data.updatedAt is timestamp;
    }

    // --- Connection Check Document ---
    match /test/connection {
      allow get: if true;
    }

    // --- Admins Collection ---
    match /admins/{uid} {
      allow get: if isVerifiedUser() && isValidId(uid) && (uid == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser()
        && isValidId(uid)
        && isValidAdmin(incoming())
        && incoming().uid == uid
        && incoming().createdAt == request.time
        && isAdmin();
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(uid) && isAdmin();
    }

    // --- Authorized Clients Allowlist & Revenue Metrics ---
    match /clients/{clientEmail} {
      allow get: if isVerifiedUser() && isValidEmailId(clientEmail) && (
        clientEmail == userEmail() || isAdmin()
      );
      allow list: if isAdmin();
      allow create: if isVerifiedUser()
        && isValidEmailId(clientEmail)
        && isValidClient(incoming())
        && incoming().email == clientEmail
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().createdBy == request.auth.uid
        && isAdmin();
      allow update: if isVerifiedUser()
        && isValidEmailId(clientEmail)
        && isValidClient(incoming())
        && (
          // Action 1: Admin manages client access, plan, amountPaid, notes
          (
            incoming().email == existing().email
            && incoming().createdAt == existing().createdAt
            && incoming().createdBy == existing().createdBy
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'clientName', 'active', 'planName', 'amountPaid', 'currency', 'notes', 'updatedAt'
            ])
            && isAdmin()
          )
          ||
          // Action 2: Authorized verified client records a studio login
          (
            clientEmail == userEmail()
            && existing().active == true
            && (existing().uid == '' || existing().uid == request.auth.uid)
            && incoming().uid == request.auth.uid
            && incoming().email == existing().email
            && incoming().active == existing().active
            && incoming().amountPaid == existing().amountPaid
            && incoming().currency == existing().currency
            && incoming().planName == existing().planName
            && incoming().clientName == existing().clientName
            && incoming().notes == existing().notes
            && incoming().createdAt == existing().createdAt
            && incoming().createdBy == existing().createdBy
            && incoming().loginCount == existing().loginCount + 1
            && incoming().lastLoginAt == request.time
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'uid', 'displayName', 'photoURL', 'loginCount', 'lastLoginAt', 'updatedAt'
            ])
          )
        );
      allow delete: if isVerifiedUser() && isValidEmailId(clientEmail) && isAdmin();
    }

    // --- Pending Access Requests ---
    match /accessRequests/{uid} {
      allow get: if isVerifiedUser() && isValidId(uid) && (uid == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser()
        && isValidId(uid)
        && uid == request.auth.uid
        && isValidAccessRequest(incoming())
        && incoming().uid == request.auth.uid
        && incoming().email == userEmail()
        && incoming().status == 'pending'
        && incoming().requestedAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(uid)
        && isValidAccessRequest(incoming())
        && (
          (
            incoming().uid == existing().uid
            && incoming().email == existing().email
            && incoming().requestedAt == existing().requestedAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
            && isAdmin()
          )
          ||
          (
            uid == request.auth.uid
            && existing().status != 'approved'
            && incoming().status == 'pending'
            && incoming().uid == existing().uid
            && incoming().email == existing().email
            && incoming().requestedAt == existing().requestedAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'photoURL', 'status', 'updatedAt'
            ])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(uid) && (uid == request.auth.uid || isAdmin());
    }

    // --- Studio Entry Audit Logs ---
    match /accessLogs/{logId} {
      allow get: if isVerifiedUser() && isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isVerifiedUser()
        && isValidId(logId)
        && isValidAccessLog(incoming())
        && incoming().uid == request.auth.uid
        && incoming().email == userEmail()
        && incoming().enteredAt == request.time
        && isNotSuspendedVerifiedUser();
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(logId) && isAdmin();
    }

    // --- Per-User Cloud Workspace (Playlists & Samplers) ---
    match /userWorkspaces/{uid} {
      allow get: if isVerifiedUser() && isValidId(uid) && (
        (uid == request.auth.uid && isNotSuspendedVerifiedUser()) || isAdmin()
      );
      allow list: if isAdmin();
      allow create: if isVerifiedUser()
        && isValidId(uid)
        && uid == request.auth.uid
        && isValidUserWorkspace(incoming())
        && incoming().uid == request.auth.uid
        && incoming().email == userEmail()
        && incoming().updatedAt == request.time
        && isNotSuspendedVerifiedUser();
      allow update: if isVerifiedUser()
        && isValidId(uid)
        && uid == request.auth.uid
        && isValidUserWorkspace(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'playlists', 'tracksMeta', 'samplerBanks', 'activeBankId', 'updatedAt'
        ])
        && isNotSuspendedVerifiedUser();
      allow delete: if isVerifiedUser() && isValidId(uid) && (uid == request.auth.uid || isAdmin());
    }
  }
}
